<odoo>
    <data>
        <record model="ir.ui.view" id="up_period_list">
            <field name="name">up.period.list ()</field>
            <field name="model">up.period</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="date" />
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_period_form">
            <field name="name">up.period.form ()</field>
            <field name="model">up.period</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <group>
                    <field name="name" />
                    <field name="date" />
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_period_action_window">
            <field name="name">Period list</field>
            <field name="res_model">up.period</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="up_period_menu_item"
                  name="Period's list"
                  parent="up_general_data_menu"
                  action="up_period_action_window"
                  sequence="50"/>
    </data>
</odoo>