<odoo>
    <data>
        <record model="ir.ui.view" id="up_type_utility_list">
            <field name="name">up.type.utility.list ()</field>
            <field name="model">up.type.utility</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_type_utility_action_window">
            <field name="name">Type of utility list</field>
            <field name="res_model">up.type.utility</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="up_type_utility_menu_item"
                  name="Type of Utility"
                  parent="up_general_data_menu"
                  action="up_type_utility_action_window"
                  sequence="10"/>
    </data>
</odoo>