<odoo>
    <data>
        <record model="ir.ui.view" id="up_charge_list">
            <field name="name">up.charge.list ()</field>
            <field name="model">up.charge</field>
            <field name="arch" type="xml">
                <list>
                    <field name="apartment_id"/>
                    <field name="period_id"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_charge_form">
            <field name="name">up.charge.form ()</field>
            <field name="model">up.charge</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <group>
                        <field name="apartment_id"/>
                        <field name="period_id"/>
                    </group>
                    <notebook>
                        <page string="Utility list" name="utility_list">
                            <field name="charge_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="sum" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_charge_action_window">
            <field name="name">Charge</field>
            <field name="res_model">up.charge</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- server action to the one above -->
        <!--
            <record model="ir.actions.server" id="utility_pyments.action_server">
              <field name="name">utility_pyments server</field>
              <field name="model_id" ref="model_utility_pyments_utility_pyments"/>
              <field name="state">code</field>
              <field name="code">
                action = {
                  "type": "ir.actions.act_window",
                  "view_mode": "list,form",
                  "res_model": model._name,
                }
              </field>
            </record>
        -->

        <menuitem id="ut_charge_menu_item"
                  name="Charge"
                  parent="up_payments_menu"
                  action="up_charge_action_window"
                  sequence="10"/>
    </data>
</odoo>