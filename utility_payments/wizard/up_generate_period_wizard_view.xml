<odoo>
    <record id="up_generate_period_wizard_form" model="ir.ui.view">
        <field name="name">up.period.generate.wizard.form</field>
        <field name="model">up.period.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>

                    <field name="begin_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_create_period_list"
                            type="object"
                            string="Generate Period List"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="up_period_generate_wizard_act_window" model="ir.actions.act_window">
        <field name="name">Generate Period List</field>
        <field name="res_model">up.period.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!--field name="binding_model_id" ref="model_osl_library_book"/-->
        <!--field name="binding_model_id" ref="model_up_period"/>
        <field name="binding_view_types">list</field-->
    </record>

    <menuitem id="up_period_generate_wizard_menu_item"
              name="Generate Period List"
              parent="up_general_data_menu"
              action="up_period_generate_wizard_act_window"
              sequence="60"/>

</odoo>
