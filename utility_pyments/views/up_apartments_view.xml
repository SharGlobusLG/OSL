<odoo>
    <data>
        <record model="ir.ui.view" id="up_apartment_list">
            <field name="name">up.apartment.list ()</field>
            <field name="model">ut.apartment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="address"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="up_apartment_form">
            <field name="name">up.apartment.form ()</field>
            <field name="model">ut.apartment</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="up_apartment_action_window">
            <field name="name">Apartment</field>
            <field name="res_model">ut.apartment</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- server action to the one above -->
