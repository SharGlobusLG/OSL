                action = {
                  "type": "ir.actions.act_window",
                  "view_mode": "list,form",
                  "res_model": model._name,
                }
              </field>
            </record>
        -->

        <menuitem id="ut_apartment_menu_item"
                  name="Apartment"
                  parent="up_general_data_menu"
                  action="up_apartment_action_window"/>
    </data>
</odoo>