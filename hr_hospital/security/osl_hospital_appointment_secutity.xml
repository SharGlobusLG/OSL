<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="osl_hospital_appoinment_rule_patient" model="ir.rule">
        <field name="name">Appointment - Patient</field>
        <field name="model_id" ref="model_osl_hospital_appointment"/>
        <field name="domain_force">[('patient_id.user.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_patient')),
            ]"/>
    </record>

    <!--record id="osl_hospital_history_rule_patient" model="ir.rule">
        <field name="name">Appointment - Patient</field>
        <field name="model_id" ref="model_osl_hospital_doctor_history"/>
        <field name="domain_force">[('patient_id.user.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_patient')),
            ]"/>
    </record-->

    <record id="osl_hospital_appoinment_rule_intern" model="ir.rule">
        <field name="name">Appointment - Intern</field>
        <field name="model_id" ref="model_osl_hospital_appointment"/>
        <field name="domain_force">[('doctor_id.user.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_intern')),
            ]"/>
    </record>

    <record id="osl_hospital_appoinment_rule_doctor" model="ir.rule">
        <field name="name">Appointment - Intern</field>
        <field name="model_id" ref="model_osl_hospital_appointment"/>
        <field name="domain_force">["|",('doctor_id.user.id', '=', user.id),('doctor_id.mentor.user.id', '=', user.id)]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_doctor')),
            ]"/>
    </record>

    <record id="osl_hospital_appoinment_rule_manager" model="ir.rule">
        <field name="name">Appointment - Intern</field>
        <field name="model_id" ref="model_osl_hospital_appointment"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_manager')),
            ]"/>
    </record>

    <record id="osl_hospital_appoinment_rule_admin" model="ir.rule">
        <field name="name">Appointment - Admin</field>
        <field name="model_id" ref="model_osl_hospital_appointment"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[
                Command.link(ref('osl_hospital_group_administrator')),
            ]"/>
    </record>
