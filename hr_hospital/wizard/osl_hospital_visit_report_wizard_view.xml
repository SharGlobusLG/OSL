<odoo>
    <record id="visit_report_wizard_form" model="ir.ui.view">
        <field name="name">visit.report.wizard.form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visits Report">
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="patient_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="disease_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="only_completed"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_report" type="object" string="Generate Report" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_visit_report_from_patient" model="ir.actions.act_window">
        <field name="name">Appointments report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_osl_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_visit_report_from_doctor" model="ir.actions.act_window">
        <field name="name">Appointments report</field>
        <field name="res_model">visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_osl_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
